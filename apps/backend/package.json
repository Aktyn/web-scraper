{
  "name": "@web-scraper/backend",
  "version": "4.1.1",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p ./tsconfig.build.json",
    "build:standalone": "node build.mjs",
    "dev": "tsx --watch src/main.ts | pino-pretty --colorize",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*{.ts,.tsx}\" --fix",
    "typecheck": "tsc --noEmit --skipLibCheck -p ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:generate-erd": "drizzle-erd --in ./src/db/schema/index.ts --out ERD.svg",
    "db:reset": "rm -rf data.db && npm run db:generate && npm run db:migrate && npm run db:generate-erd",
    "db:reset:seed": "npm run db:reset && tsx src/db/seed/auto-seed.ts",
    "db:show": "drizzle-kit studio"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/static": "^10.1.6",
    "@libsql/client": "^0.18.0",
    "@web-scraper/common": "*",
    "@web-scraper/core": "*",
    "args": "^5.0.3",
    "chromium-bidi": "^17.0.2",
    "dotenv": "^18.0.7",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "fastify-plugin": "^6.0.0",
    "fastify-sse-v2": "^4.2.2",
    "fastify-type-provider-zod": "^7.0.0",
    "node-file-dialog": "^1.0.3",
    "node-systray-v2": "github:Edgar-P-yan/node-systray-v2",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/args": "^5.0.4",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-erd": "^0.0.1-alpha.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
